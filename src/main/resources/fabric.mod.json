{
	"schemaVersion": 1,
	"id": "thirst",
	"version": "${version}",
	"name": "Thirst Was Taken",
	"description": "Add Thirst bar and hydration. A fork of Thirst Was Taken combining with Thirst Was Reclaimed",
	"authors": [
		"break08"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/thirst-was-taken-reload/",
		"sources": "https://github.com/break08/thirst-was-taken-reload"
	},
	"license": "MIT",
	"icon": "assets/thirst/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.thirsty.ThirstWasTaken",
			"com.thirsty.effect.ModEffect"
		],
		"cardinal-components": [
			"com.thirsty.api.cca.ModComponent"
		],
		"modmenu": [
			"com.thirsty.api.config.ModMenuIntegration"
		],
		"client": [
			"com.thirsty.ThirstWasTakenClient"
		]
	},
	"mixins": [
		"thirst.mixins.json"
	],
	"custom": {
		"cardinal-components": [
			"thirst:player_thirst"
		]
	},
	"accessWidener": "thirst.accesswidener",
	"suggests": {
		"toughasnails": "*",
		"appleskin": "*",
		"farmersdelight": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"cardinal-components": "*",
		"cloth-config": "*"
	}
}